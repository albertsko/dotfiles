export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

export DOTFILES_HOME="$XDG_STATE_HOME/dotfiles"
export DEV_HOME="$HOME/dev"
export VAULT_HOME="${VAULT_HOME:-$HOME/vault}"
export VAULT_GIT_DIR="$XDG_DATA_HOME/.vault.git"

for brew_bin in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
	[[ -x "$brew_bin" ]] || continue
	eval "$("$brew_bin" shellenv)"
	break
done
unset brew_bin

# Non-interactive shells reach tools from mise [tools] through shims, after Homebrew tools.
export PATH="$PATH:$XDG_DATA_HOME/mise/shims"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$PATH:$HOME/go/bin"

export EDITOR="vim"
export VISUAL="vim"
export MANPAGER="less -X"
export HUNK_TEXT_PAGER="less -R"
export BAT_THEME="ansi"
export HOMEBREW_NO_ANALYTICS=1
