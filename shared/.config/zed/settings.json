// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // --- Languages ---
  "languages": {
    "PHP": {
      "language_servers": [
        "phpantom",
        "!intelephense",
        "!phpactor",
        "!phptools",
      ],
    },
    "Go": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
      "language_servers": ["gopls", "golangci-lint"],
    },
    "Go Mod": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
    },
    "Shell Script": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}"],
        },
      },
    },
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "gofumpt": true,
      },
    },
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path=",
        ],
      },
    },
  },
  "auto_install_extensions": {
    "golangci-lint": true,
  },
  // --- General ---
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "ui_font_size": 17,
  "auto_update": true,
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "cli_default_open_behavior": "existing_window",
  // */libexec/src/** is addded for Go's stdlib view
  "file_scan_inclusions": [".env*", "*/libexec/src/**"],
  // --- Text Editor ---
  "cursor_shape": "bar",
  "cursor_blink": false,
  "buffer_font_family": "JetBrainsMonoNL Nerd Font",
  "buffer_font_size": 15,
  "buffer_line_height": "comfortable",
  "autosave": "on_focus_change",
  "format_on_save": "off",
  "inline_code_actions": false,
  "hard_tabs": false,
  // "show_signature_help_after_edits": true,
  "extend_comment_on_newline": false,
  "excerpt_context_lines": 6,
  "expand_excerpt_lines": 12,
  "outline_panel": {
    "dock": "right",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "right",
  },
  "inlay_hints": {
    "enabled": false,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "agent_review": false,
    "code_actions": false,
    "selections_menu": false,
  },
  "tabs": {
    "activate_on_close": "neighbour",
    "close_position": "right",
    "git_status": true,
    "show_close_button": "hover",
    "show_diagnostics": "errors",
  },
  "project_panel": {
    "git_status": false,
    "hide_gitignore": false,
    "dock": "right",
    "entry_spacing": "comfortable",
    "default_width": 200,
    "indent_size": 12,
    "indent_guides": {
      "show": "never",
    },
    "auto_reveal_entries": true,
  },
  "terminal": {
    "line_height": "comfortable",
    "toolbar": {
      "breadcrumbs": false,
    },
    "dock": "right",
  },
  "minimap": {
    "show": "never",
  },
  "scrollbar": {
    "show": "never",
  },
  "gutter": {
    "line_numbers": true,
    "runnables": false,
    "breakpoints": false,
    "folds": false,
    "min_line_number_digits": 0,
  },
  // --- Tools ---
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "diff_view_style": "split",
}
