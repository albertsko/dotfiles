font-size=16
font-family="JetBrainsMonoNL Nerd Font"

theme="Everforest Dark Hard"

cursor-style=block
cursor-style-blink=false
cursor-invert-fg-bg=true
adjust-cursor-thickness=3

macos-option-as-alt=true

window-position-x=0
window-position-y=0
window-width=999
window-height=999

keybind=global:unconsumed:super+enter=ignore

keybind=super+shift+h=activate_key_table:herdr
keybind=herdr/
keybind=herdr/super+shift+h=deactivate_key_table
keybind=herdr/performable:super+ctrl+alt+shift+z=csi:122;16u
keybind=herdr/performable:super+d=csi:100;9u
keybind=herdr/performable:super+shift+d=csi:100;10u
keybind=herdr/performable:super+[=csi:91;9u
