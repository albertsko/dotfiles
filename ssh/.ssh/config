Include config.d/*.conf

# macOS stores the key in the Keychain; other systems ignore this option.
IgnoreUnknown UseKeychain

Host *
    AddKeysToAgent yes
    UseKeychain yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts yes

Host github.com
    Hostname github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
